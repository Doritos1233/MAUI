<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp9.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            
            <Entry Placeholder="podaj wartość"
                   x:Name="dupa"/>
            
            <Button Text="Add" 
                    Clicked="Onclicked"/>

            <Button Text="Delete last element" 
                Clicked="deleteLastElement"/>
            
            <Button Text="Clear" 
                Clicked="clearCol"/>

            <CollectionView
                x:Name="kolekcja">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Span="2" Orientation="Vertical" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Label Text="{Binding .}"></Label>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
